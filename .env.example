# issue2pr-mail-relay — environment variables
# Copy the ones you need into your Vercel project (Settings -> Environment
# Variables). Everything is optional EXCEPT one provider. Set only what you use.

# ---- Provider (pick ONE; this is the only required group) ----

# Option A: Resend (best deliverability, needs an owned + verified domain).
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=Issue2PR Agent <agent@yourdomain.com>

# Option B: Generic SMTP (SendGrid, Brevo, Mailgun, Gmail, ...).
# Works with single-sender verification, but for real deliverability
# authenticate an OWNED domain (freemail From addresses get spam-filtered).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login@example.com
# SMTP_PASS=xsmtpsib-your-brevo-smtp-key
# SMTP_FROM=Issue2PR Agent <agent@yourdomain.com>

# Option C: Gmail shortcut (App Password). Used only if the two above are unset.
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-16-char-app-password

# ---- Auth (optional; recommended for public deployments) ----

# Require a valid GitHub OIDC token on every call.
# REQUIRE_OIDC=1
# Expected audience claim (the workflow requests this value).
# OIDC_AUDIENCE=issue2pr-mail-relay
# CSV allowlist of repo owners permitted to send. Empty = any valid token.
# OIDC_ALLOWED_OWNERS=your-github-username

# Shared token (X-Relay-Token). Only checked when a call has no OIDC token.
# RELAY_TOKEN=some-long-random-string

# ---- Rate limit (optional; Upstash Redis REST) ----

# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxx
# RATE_LIMIT_PER_DAY=50
